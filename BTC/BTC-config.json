{
  "chain": "BTC",
  "name": "Bitcoin",
  "website": "https://bitcoincore.org",
  "client": "bitcoind / Bitcoin-Qt",

  "datadir": {
    "windows": "%APPDATA%/Bitcoin",
    "darwin": "~/Library/Application Support/Bitcoin",
    "linux": "~/.bitcoin"
  },
  "testnet_dir": "testnet3",
